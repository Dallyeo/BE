# Dallyeo 환경변수 예시 (실제 값 채워 .env 로 복사 — .env 는 git 제외)
# N3(Security Baseline): 시크릿은 코드/VCS 저장 금지, 환경변수로만 주입.

# ===== TourAPI (U1-a) =====
# 공공데이터포털 TourAPI(KorService2) 인증키 (Decoding 키 권장)
TOURAPI_SERVICE_KEY=

# ===== Database (U4/U5부터 사용) =====
DB_USERNAME=
DB_PASSWORD=

# ===== JWT (U4/U1-b 인증부터 사용) =====
# HS256 서명키 — 최소 32바이트(256bit) 이상 랜덤 문자열 권장. 미설정 시 부팅 실패.
JWT_SECRET=

# ===== Apple 로그인 (U4) =====
# Apple identity token aud 검증용 client_id(앱 번들ID 또는 서비스ID). Kakao는 별도 시크릿 불필요(access token 조회 방식).
APPLE_CLIENT_ID=
