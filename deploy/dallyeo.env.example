# 서버 시크릿 — /etc/dallyeo/dallyeo.env 로 복사 후 실제 값 채우기.
# systemd(dallyeo@.service)의 EnvironmentFile 로 주입됨. 절대 git 에 올리지 말 것(권한 600 권장).
#   sudo install -m 600 dallyeo.env.example /etc/dallyeo/dallyeo.env  후 편집

DB_USERNAME=dallyeo
DB_PASSWORD=change-me
TOURAPI_SERVICE_KEY=change-me
JWT_SECRET=change-me-min-32-chars

# 러닝 기록 이미지 저장 디렉터리 — 반드시 절대경로로 지정할 것.
#   systemd 유닛에 WorkingDirectory가 없어서 기본값 ./uploads 는 '/uploads' 로 해석된다.
#   블루-그린 두 인스턴스(8080/8081)가 이 파일을 공유하므로 같은 경로를 함께 바라본다.
#   준비: sudo mkdir -p /var/lib/dallyeo/uploads && sudo chown dallyeo:dallyeo /var/lib/dallyeo/uploads
UPLOAD_DIR=/var/lib/dallyeo/uploads

# 응답의 이미지 URL 기준 도메인. 설정하지 않으면 http://localhost:8080 이 되어
# 앱에서 이미지가 표시되지 않는다. 운영에서는 반드시 실제 도메인으로 지정할 것.
PUBLIC_BASE_URL=https://dallyeo.cloud
